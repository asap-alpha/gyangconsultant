{
  "name": "gyang-corporate-consult",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corporate website for Gyang Corporate Consult",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite-ssg build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "check": "npm run lint:check && npm run type-check && npm run test",
    "logo": "python3 scripts/prepare-logo.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@unhead/vue": "^2.1.17",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.3.5",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
